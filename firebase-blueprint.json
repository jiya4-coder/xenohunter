{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with study settings and statistics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "classLevel": { "type": "string" },
        "primaryExam": { "type": "string" },
        "language": { "type": "string" },
        "dailyHours": { "type": "number" },
        "dayStreak": { "type": "number" },
        "questionsSolved": { "type": "number" },
        "testAccuracy": { "type": "number" },
        "studyTimeMinutes": { "type": "number" }
      },
      "required": ["uid"]
    },
    "Mistake": {
      "title": "Mistake",
      "description": "Mistake recorded from mock tests or chapter quizzes for mastery review.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "testTopic": { "type": "string" },
        "subject": { "type": "string" },
        "classLevel": { "type": "string" },
        "question": { "type": "string" },
        "userAnswer": { "type": "number" },
        "correctAnswer": { "type": "number" },
        "userAnswerText": { "type": "string" },
        "correctAnswerText": { "type": "string" },
        "explanation": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "mastered": { "type": "boolean" }
      },
      "required": ["id", "question", "correctAnswerText", "mastered"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Generated or saved study revision note.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "subject": { "type": "string" },
        "classLevel": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat prompt history item from AI Tutor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "responsePreview": { "type": "string" },
        "fullResponse": { "type": "string" },
        "timestamp": { "type": "string" },
        "mode": { "type": "string" },
        "starred": { "type": "boolean" }
      },
      "required": ["id", "prompt"]
    },
    "PlannerSchedule": {
      "title": "PlannerSchedule",
      "description": "Student master timetable and exam dates configuration.",
      "type": "object",
      "properties": {
        "classNum": { "type": "number" },
        "dailyHours": { "type": "number" },
        "studyWindow": { "type": "string" }
      },
      "required": ["classNum", "dailyHours"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Stores user profiles and study configurations."
    },
    "/users/{userId}/mistakes/{mistakeId}": {
      "schema": "#/entities/Mistake",
      "description": "Stores mistake records for the student Mistake Book."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "#/entities/StudyNote",
      "description": "Stores saved notes for the student."
    },
    "/users/{userId}/chat_messages/{msgId}": {
      "schema": "#/entities/ChatMessage",
      "description": "Stores AI Tutor prompts history."
    },
    "/users/{userId}/planner/{plannerId}": {
      "schema": "#/entities/PlannerSchedule",
      "description": "Stores exam schedule and timetable."
    }
  }
}
